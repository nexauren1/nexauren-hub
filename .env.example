SITE_URL=https://your-domain.example
PUBLIC_CONTACT_EMAIL=

# Firebase Web App configuration (public client values, not server secrets).
# Copy these from Firebase Console > Project settings > Your apps > Web app.
PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your-project-id
PUBLIC_FIREBASE_APP_ID=your_firebase_web_app_id
PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
