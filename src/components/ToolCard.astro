---
const {tool}=Astro.props;
---
<a class="tool-card" href={`/tools/${tool.category}/${tool.slug}/`} data-tool-card data-search={`${tool.name} ${tool.tagline} ${tool.description} ${tool.keywords.join(" ")}`.toLowerCase()}>
<span class="tool-icon">{tool.icon}</span><span class="tool-card-content"><span class="tool-card-title">{tool.name}<span class="card-arrow">↗</span></span><span class="tool-card-description">{tool.tagline}</span><span class="tool-card-meta"><span class="mini-dot"></span> Free tool</span></span></a>