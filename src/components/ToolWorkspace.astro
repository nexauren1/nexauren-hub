---
const {tool}=Astro.props;
---
<section class="workspace-panel" data-tool-root data-tool-id={tool.id} aria-labelledby="workspace-title">
<div class="workspace-top"><div><span class="eyebrow">TOOL WORKSPACE</span><h2 id="workspace-title">Get started</h2><p>Files are processed in this browser session.</p></div><span class="privacy-chip"><i></i> Local processing</span></div>
{tool.category==="image"&&<div class="tool-controls">
<label class="field-label">Choose an image<input data-files type="file" accept="image/*" class="file-input"/></label><p class="field-hint">JPG, PNG, WebP and other browser-supported images.</p>
{tool.mode==="image-resizer"&&<div class="field-grid"><label class="field-label">Width (px)<input data-width type="number" min="1" max="12000" value="1200"/></label><label class="field-label">Height (px)<input data-height type="number" min="1" max="12000" value="800"/></label></div>}
{tool.mode==="image-resizer"&&<label class="check-row"><input data-lock type="checkbox" checked/> Keep aspect ratio</label>}
<label class="field-label">Output format<select data-format><option value="image/webp">WebP</option><option value="image/jpeg">JPEG</option><option value="image/png">PNG</option></select></label>
{tool.mode!=="image-converter"&&<label class="field-label">Quality <span data-quality-value class="range-current">82%</span><input data-quality type="range" min="20" max="100" value="82"/><span class="range-scale"><span>Smaller file</span><span>Higher quality</span></span></label>}
<button class="button button-primary tool-submit" data-run type="button">{tool.mode==="image-resizer"?"Resize image":tool.mode==="image-compressor"?"Compress image":"Convert image"} →</button>
<div class="result-box" data-output aria-live="polite"><span class="result-placeholder-icon">✧</span><p>Your result will appear here.</p></div></div>}
{tool.category==="text"&&<div class="tool-controls">
<label class="field-label">Your text<textarea data-input-text rows="8" placeholder="Type or paste your text here…"></textarea></label>
{tool.mode==="word-counter"&&<div class="stat-grid"><div class="stat-card"><strong data-words>0</strong><span>Words</span></div><div class="stat-card"><strong data-characters>0</strong><span>Characters</span></div><div class="stat-card"><strong data-no-spaces>0</strong><span>No spaces</span></div><div class="stat-card"><strong data-sentences>0</strong><span>Sentences</span></div><div class="stat-card"><strong data-paragraphs>0</strong><span>Paragraphs</span></div></div>}
{tool.mode==="case-converter"&&<div class="button-row"><button class="button button-secondary" data-case="upper" type="button">UPPERCASE</button><button class="button button-secondary" data-case="lower" type="button">lowercase</button><button class="button button-secondary" data-case="title" type="button">Title Case</button><button class="button button-secondary" data-case="sentence" type="button">Sentence case</button></div>}
{tool.mode==="remove-duplicate-lines"&&<div class="option-row"><label class="check-row"><input data-case-sensitive type="checkbox" checked/> Case-sensitive</label><label class="check-row"><input data-trim-lines type="checkbox" checked/> Ignore surrounding whitespace</label></div>}
{tool.mode!=="word-counter"&&<><div class="button-row"><button class="button button-primary" data-run type="button">{tool.mode==="case-converter"?"Convert text":"Remove duplicates"} →</button><button class="button button-secondary" data-copy type="button">Copy result</button></div><label class="field-label">Result<textarea data-result-text rows="7" placeholder="Your result will appear here…" readonly></textarea></label></>}
<div data-message role="status" aria-live="polite" class="result-message"></div></div>}
{tool.category==="pdf"&&<div class="tool-controls"><label class="field-label">{tool.mode==="merge-pdf"?"Choose PDF files":"Choose a PDF file"}<input data-files type="file" accept="application/pdf,.pdf" class="file-input" multiple={tool.mode==="merge-pdf"}/></label><p class="field-hint">{tool.mode==="merge-pdf"?"Choose at least two PDFs. Page order follows the order in the file picker.":"Page numbers start at 1; ranges work too, e.g. 1, 3-5, 8."}</p>{tool.mode==="extract-pdf-pages"&&<label class="field-label">Pages to extract<input data-pages type="text" placeholder="e.g. 1, 3-5, 8"/></label>}<button class="button button-primary tool-submit" data-run type="button">{tool.mode==="merge-pdf"?"Merge PDFs":"Extract pages"} →</button><div class="result-box" data-output aria-live="polite"><span class="result-placeholder-icon">▤</span><p>Your PDF will be created here.</p></div></div>}
{tool.category==="audio"&&<div class="tool-controls"><label class="field-label">Choose an audio file<input data-files type="file" accept="audio/*,.mp3,.wav,.m4a,.ogg,.aac,.flac" class="file-input"/></label><p class="field-hint">The browser must support decoding the source audio format.</p><div data-audio-info class="audio-info" hidden></div>{tool.mode==="audio-trimmer"&&<div class="field-grid"><label class="field-label">Start (seconds)<input data-start type="number" min="0" step="0.1" value="0"/></label><label class="field-label">End (seconds)<input data-end type="number" min="0" step="0.1" placeholder="Duration"/></label></div>}<audio data-preview controls hidden></audio><button class="button button-primary tool-submit" data-run type="button">{tool.mode==="audio-trimmer"?"Trim and export WAV":"Convert to WAV"} →</button><div class="result-box" data-output aria-live="polite"><span class="result-placeholder-icon">♫</span><p>Your WAV file will appear here.</p></div></div>}
<p class="workspace-disclaimer">For large files, keep this tab open until processing finishes. Format support and practical limits depend on your device and browser.</p>
</section>
<script>
import {mountTool} from "../lib/tool-runtime";
document.querySelectorAll<HTMLElement>("[data-tool-root]").forEach(root=>mountTool(root));
</script>