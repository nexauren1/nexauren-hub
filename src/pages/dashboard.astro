import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Dashboard Preview — Nexauren Hub" description="Preview of the planned Nexauren Hub dashboard." noindex={true}>
<main id="main-content" class="page-main"><div class="container dashboard-container"><nav class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Dashboard preview</span></nav><section class="dashboard-welcome"><div><span class="eyebrow">YOUR WORKSPACE · PREVIEW</span><h1>A clearer view of <span class="gradient-text">your toolkit.</span></h1><p>This is a design preview. There is no signed-in user or saved account data yet.</p></div><span class="dashboard-avatar">N</span></section><div class="dashboard-notice"><span>ⓘ</span><div><strong>Account features are not active</strong><p>Favorites, saved preferences and personal usage history require a secure authentication backend.</p></div><a href="/tools/" class="text-link">Use tools ↗</a></div><div class="dashboard-grid"><article class="dashboard-stat"><span class="dashboard-stat-icon">▧</span><span>Available categories</span><strong>04</strong><small>Image · PDF · Text · Audio</small></article><article class="dashboard-stat"><span class="dashboard-stat-icon">✦</span><span>Current experience</span><strong>Free</strong><small>Available to everyone</small></article><article class="dashboard-stat"><span class="dashboard-stat-icon">↗</span><span>Saved tools</span><strong>—</strong><small>Requires an account</small></article></div><section class="dashboard-lower"><div><div class="section-heading"><div><span class="eyebrow">QUICK ACCESS</span><h2>Start with a tool</h2></div></div><div class="quick-link-grid"><a href="/tools/image/"><span>▧</span>Image tools <b>→</b></a><a href="/tools/pdf/"><span>▤</span>PDF tools <b>→</b></a><a href="/tools/text/"><span>¶</span>Text tools <b>→</b></a><a href="/tools/audio/"><span>♫</span>Audio tools <b>→</b></a></div></div><aside class="upgrade-mini"><span class="eyebrow">THE ROAD AHEAD</span><h2>More control, when it matters.</h2><p>Optional upgrades may be introduced only after the free tools provide lasting value.</p><a class="text-link" href="/upgrade/">Explore the plan preview ↗</a></aside></section></div></main>
</BaseLayout>