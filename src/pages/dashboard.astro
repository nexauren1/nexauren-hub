---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Your Dashboard — Nexauren Hub" description="Manage your Nexauren Hub account and access the online tool library." noindex={true}>
<main id="main-content" class="page-main"><div class="container dashboard-container" data-auth-dashboard><nav class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Dashboard</span></nav><section data-auth-loading class="account-loading"><span class="loading-mark">N</span><h1>Loading your workspace…</h1><p>Checking your account.</p></section><div data-auth-loaded hidden><section class="dashboard-welcome"><div><span class="eyebrow">YOUR NEXAUREN WORKSPACE</span><h1>Hello, <span class="gradient-text" data-user-name>there</span>.</h1><p>Manage your account and return to the tools for your next task.</p><p class="signed-in-email" data-user-email></p></div><span class="dashboard-avatar">N</span></section><div class="dashboard-action-bar"><div><strong>You're signed in.</strong><p>Your free online tools remain available without an account.</p></div><button type="button" class="button button-secondary" data-sign-out>Sign out</button></div><div class="dashboard-grid"><a class="dashboard-stat dashboard-stat-link" href="/tools/image/"><span class="dashboard-stat-icon">▧</span><span>Image tools</span><strong>05</strong><small>Resize, compress, crop and more</small></a><a class="dashboard-stat dashboard-stat-link" href="/tools/pdf/"><span class="dashboard-stat-icon">▤</span><span>PDF tools</span><strong>05</strong><small>Merge, extract, rotate and more</small></a><a class="dashboard-stat dashboard-stat-link" href="/tools/text/"><span class="dashboard-stat-icon">¶</span><span>Text tools</span><strong>05</strong><small>Count, compare, format and clean</small></a><a class="dashboard-stat dashboard-stat-link" href="/tools/audio/"><span class="dashboard-stat-icon">♫</span><span>Audio tools</span><strong>05</strong><small>Trim, join, inspect and convert</small></a></div><div class="account-info-card"><span class="eyebrow">ACCOUNT STATUS</span><h2>Free access</h2><p>All current tools are free. No payment method or subscription is required.</p><a class="text-link" href="/tools/">Explore the tool library ↗</a></div></div><p class="auth-feedback" data-auth-message role="status" aria-live="polite" hidden></p></div></main><script>import "../scripts/auth-forms";</script>
</BaseLayout>