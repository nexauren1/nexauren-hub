---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Account Settings — Nexauren Hub" description="View your Nexauren Hub account and manage your sign-in." noindex={true}>
<main id="main-content" class="page-main"><div class="container account-container"><nav class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Account</span></nav><section class="account-card account-card-light" data-auth-dashboard><span class="brand-mark account-logo">N</span><span class="eyebrow">ACCOUNT SETTINGS</span><h1>Your account, <span class="gradient-text">your tools.</span></h1><p data-auth-loading>Checking your account…</p><div data-auth-loaded hidden><p class="account-user-name" data-user-name></p><p class="account-user-email" data-user-email></p><div class="account-actions"><a class="button button-primary" href="/dashboard/">Open dashboard →</a><button type="button" class="button button-secondary" data-sign-out>Sign out</button></div></div><p class="auth-feedback" data-auth-message role="status" aria-live="polite" hidden></p></section></div></main><script>import "../scripts/auth-forms";</script>
</BaseLayout>