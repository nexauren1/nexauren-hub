---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Your Account — Nexauren Hub" description="Account area for Nexauren Hub. Account services are not connected in this release." noindex={true}>
<main id="main-content" class="page-main"><div class="container account-container"><nav class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Account</span></nav><section class="account-card"><span class="brand-mark account-logo">N</span><span class="eyebrow">YOUR NEXAUREN SPACE</span><h1>Your account, <span class="gradient-text">your tools.</span></h1><p class="account-lead">The account area is being prepared. You can use public tools without registering.</p><div class="account-actions"><a class="button button-primary" href="/tools/">Explore free tools →</a><a class="button button-secondary" href="/login/">Login preview</a></div><p class="notice-inline">ⓘ Accounts are not enabled yet. This page stores no personal account data.</p></section></div></main>
</BaseLayout>