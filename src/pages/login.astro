---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Log In — Nexauren Hub" description="Log in to Nexauren Hub with email and password or Google." noindex={true}>
<main id="main-content" class="page-main auth-page"><div class="container auth-container"><a href="/" class="back-link">← Back to Nexauren Hub</a><section class="auth-card auth-card-light"><span class="brand-mark auth-brand">N</span><span class="eyebrow">YOUR TOOLKIT, YOUR SPACE</span><h1>Welcome <span class="gradient-text">back.</span></h1><p>Log in to manage your Nexauren Hub account.</p><button type="button" data-google-auth class="google-auth-button"><span class="google-g-mark">G</span> Continue with Google</button><div class="auth-divider"><span>or continue with email</span></div><form data-auth-form="login" class="auth-form"><label class="field-label">Email address<input name="email" type="email" autocomplete="email" placeholder="you@example.com" required/></label><label class="field-label">Password<input name="password" type="password" autocomplete="current-password" placeholder="Your password" minlength="8" required/></label><div class="auth-inline-links"><a href="/forgot-password/">Forgot password?</a></div><button type="submit" class="button button-primary button-full">Log in →</button><p class="auth-feedback" data-auth-message role="status" aria-live="polite" hidden></p></form><p class="auth-switch">New to Nexauren? <a href="/register/">Create an account</a></p><p class="auth-safety">Authentication by Firebase.</p></section></div></main><script>import "../scripts/auth-forms";</script>
</BaseLayout>