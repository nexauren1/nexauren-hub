---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Create an Account — Nexauren Hub" description="Create a Nexauren Hub account using email verification or Google sign-in." noindex={true}>
<main id="main-content" class="page-main auth-page"><div class="container auth-container"><a href="/" class="back-link">← Back to Nexauren Hub</a><section class="auth-card auth-card-light"><span class="brand-mark auth-brand">N</span><span class="eyebrow">ONE ACCOUNT, WHEN YOU NEED IT</span><h1>Create your <span class="gradient-text">space.</span></h1><p>Public tools stay free. An account is optional.</p><button type="button" data-google-auth class="google-auth-button"><span class="google-g-mark">G</span> Sign up with Google</button><div class="auth-divider"><span>or create with email</span></div><form data-auth-form="register" class="auth-form"><label class="field-label">Your name <span class="optional-label">OPTIONAL</span><input name="full_name" type="text" autocomplete="name" placeholder="Name" maxlength="80"/></label><label class="field-label">Email address<input name="email" type="email" autocomplete="email" placeholder="you@example.com" required/></label><label class="field-label">Password<input name="password" type="password" autocomplete="new-password" placeholder="At least 8 characters" minlength="8" required/><span class="field-hint">Use a unique password with at least 8 characters.</span></label><label class="check-row consent-row"><input type="checkbox" required/> I agree to the <a href="/terms/">Terms of Use</a> and have read the <a href="/privacy/">Privacy Policy</a>.</label><button type="submit" class="button button-primary button-full">Create account →</button><p class="auth-feedback" data-auth-message role="status" aria-live="polite" hidden></p></form><p class="auth-switch">Already registered? <a href="/login/">Log in</a></p><p class="auth-safety">Email confirmation is sent when required by the provider.</p></section></div></main><script>import "../scripts/auth-forms";</script>
</BaseLayout>