---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Create an Account — Nexauren Hub" description="Registration interface preview for the future Nexauren Hub account service." noindex={true}>
<main id="main-content" class="page-main"><div class="container auth-container"><a href="/" class="back-link">← Back to Nexauren Hub</a><section class="auth-card"><span class="brand-mark auth-brand">N</span><span class="eyebrow">START SIMPLE</span><h1>Create your <span class="gradient-text">space.</span></h1><p>Registration will be available when secure account services launch.</p><form data-preview-form data-form-message="Registration is not connected. Nothing was sent or stored. Please do not enter a real password." class="auth-form"><label class="field-label">Display name<input type="text" autocomplete="name" placeholder="How should we call you?" required minlength="2"/></label><label class="field-label">Email address<input type="email" autocomplete="email" placeholder="you@example.com" required/></label><label class="field-label">Create password<input type="password" autocomplete="new-password" placeholder="At least 8 characters" required minlength="8"/></label><label class="check-row consent-row"><input type="checkbox" required/> I have read the <a href="/terms/">Terms</a> and <a href="/privacy/">Privacy Policy</a>.</label><button type="submit" class="button button-primary button-full">Create account →</button><p class="result-message" data-form-feedback role="status" aria-live="polite" hidden tabindex="-1"></p></form><p class="auth-switch">Already have an account? <a href="/login/">Log in preview</a></p><p class="auth-safety">Preview only · No account will be created.</p></section></div></main>
<script>document.querySelectorAll<HTMLFormElement>("[data-preview-form]").forEach(form=>form.addEventListener("submit",event=>{event.preventDefault();const feedback=form.querySelector<HTMLElement>("[data-form-feedback]");if(feedback){feedback.textContent=form.dataset.formMessage||"This feature is not active. Nothing was submitted.";feedback.hidden=false;}}));</script>
</BaseLayout>