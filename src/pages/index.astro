---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import CategoryCard from "../components/CategoryCard.astro";
import ToolCard from "../components/ToolCard.astro";
import {categories,tools,getToolsByCategory} from "../lib/catalog";
const quickIds=["image-resizer","merge-pdf","word-counter","audio-trimmer"];
const quickTasks=quickIds.map(id=>tools.find(t=>t.id===id)!).filter(Boolean);
const popularIds=["image-compressor","extract-pdf-pages","case-converter","image-converter","remove-duplicate-lines","audio-to-wav"];
const popular=popularIds.map(id=>tools.find(t=>t.id===id)!).filter(Boolean);
---
<BaseLayout title="Free Online Tools for Images, PDF, Text & Audio | Nexauren Hub" description="Resize and compress images, merge PDF files, count words, clean text and trim audio with free online tools. No account required; browser-based processing where supported.">
<main id="main-content">
<section class="tools-first-hero">
<div class="hero-grid-pattern"></div><div class="hero-orb hero-orb-one"></div>
<div class="container tools-first-layout">
<div class="tools-first-copy">
<div class="hero-kicker"><i class="status-pulse"></i> FREE ONLINE TOOLS <span class="kicker-divider"></span> NO ACCOUNT NEEDED</div>
<h1>Get the task done.<br/><span class="gradient-text">Skip the busywork.</span></h1>
<p class="hero-description">Resize an image. Merge a PDF. Count words. Trim audio. Focused online tools that help you finish everyday file tasks without installing another app.</p>
<form class="hero-search" action="/tools/" method="get" role="search"><span class="search-symbol" aria-hidden="true">⌕</span><label class="sr-only" for="hero-search">Search online tools</label><input id="hero-search" name="q" type="search" placeholder="What do you need to do?" autocomplete="off" list="tool-suggestions"/><datalist id="tool-suggestions">{tools.map(t=><option value={t.name}/>)}</datalist><button class="button button-primary" type="submit">Find tool <span aria-hidden="true">↗</span></button></form>
<div class="hero-popular-searches"><span>Try:</span><a href="/tools/image/image-resizer/">resize an image</a><a href="/tools/pdf/merge-pdf/">merge PDFs</a><a href="/tools/text/word-counter/">count words</a></div>
<div class="hero-signals"><span><b>✓</b> Free to use</span><span><b>✓</b> No installation</span><span><b>✓</b> Files processed locally where supported</span></div>
</div>
<aside class="hero-quick-panel" aria-label="Start with a popular task">
<div class="quick-panel-header"><div><span class="eyebrow">QUICK START</span><h2>What are you working on?</h2></div><span class="quick-panel-spark">✳</span></div>
<p>Choose a task and open the tool directly.</p>
<div class="quick-task-grid">{quickTasks.map((tool,i)=><a class={`quick-task quick-task-${tool.category}`} href={`/tools/${tool.category}/${tool.slug}/`}><span class="quick-task-icon">{tool.icon}</span><span class="quick-task-copy"><strong>{tool.name}</strong><small>{tool.tagline}</small></span><span class="quick-task-arrow" aria-hidden="true">↗</span></a>)}</div>
<div class="quick-panel-footer"><span class="mini-dot"></span>{tools.length} practical tools across {categories.length} categories <a href="/tools/">View all →</a></div>
</aside>
</div>
</section>
<section class="tool-facts-strip"><div class="container tool-facts-inner"><div><span class="fact-symbol">▧</span><span><strong>{tools.length} tools</strong><small>For everyday tasks</small></span></div><div><span class="fact-symbol">▦</span><span><strong>{categories.length} categories</strong><small>Easy to browse</small></span></div><div><span class="fact-symbol">⌁</span><span><strong>Browser-based</strong><small>Where supported</small></span></div><div><span class="fact-symbol">↗</span><span><strong>No sign-up</strong><small>Start right away</small></span></div></div></section>
<section class="section-block home-categories-section"><div class="container"><SectionHeading eyebrow="BROWSE BY CATEGORY" title="Start with the file or task" description="Everything is organized around what you need to do — not around products or subscriptions." href="/tools/" linkLabel="Browse every tool"/><div class="category-grid">{categories.map(c=><CategoryCard category={c} count={getToolsByCategory(c.slug).length}/>)}</div></div></section>
<section class="section-block section-shaded home-popular-section"><div class="container"><SectionHeading eyebrow="MORE WAYS TO GET IT DONE" title="Useful tools, one click away" description="Open a focused tool, adjust what you need, and download or copy the result." href="/tools/" linkLabel="Explore all tools"/><div class="tools-grid">{popular.map(tool=><ToolCard tool={tool}/>)}</div></div></section>
<section class="section-block"><div class="container"><div class="how-it-works"><div class="how-intro"><span class="eyebrow">NO LEARNING CURVE</span><h2>From task to result<br/><span class="gradient-text">in a few steps.</span></h2><p>Each tool is built to do one job clearly. You do not need to learn a big editor or create an account to get started.</p><a class="text-link" href="/tools/">Find your tool ↗</a></div><div class="how-steps"><article><span>01</span><div><h3>Choose a tool</h3><p>Search by task or pick a category such as Image, PDF, Text or Audio.</p></div></article><article><span>02</span><div><h3>Add your file or text</h3><p>Use simple controls to select content and set the options that matter.</p></div></article><article><span>03</span><div><h3>Get your result</h3><p>Review the output, then download the file or copy the text when the tool supports it.</p></div></article></div></div></div></section>
<section class="section-block section-shaded"><div class="container"><div class="privacy-banner"><div class="privacy-banner-icon">⌁</div><div><span class="eyebrow">A THOUGHTFUL DEFAULT</span><h2>Your files should stay yours.</h2><p>Where practical, processing happens on your device instead of a remote processing server. Format support and file-size limits depend on your browser and device; each tool explains its limitations.</p><a class="text-link" href="/privacy/">How privacy works here ↗</a></div><div class="privacy-orbit"><span>✳</span><i></i><b></b></div></div></div></section>
<section class="section-block home-seo-section"><div class="container home-seo-copy"><span class="eyebrow">THE NEXAUREN TOOLBOX</span><h2>One place for everyday online tasks</h2><p>Nexauren Hub brings together free online image tools, PDF utilities, text helpers and audio tools in one clear library. Resize or compress an image before sharing it, combine PDF documents for a form or report, count words before submitting an assignment, clean duplicate lines in a list, or trim a supported audio clip. The goal is simple: provide a focused tool for a specific task, explain how it works, and make the result easy to retrieve.</p><p>You can browse by category or search for the task you have in mind. Most tools run directly in your browser, so selected files do not need to be uploaded to a Nexauren processing service. Tools work within browser and device limits, and unsupported formats will be identified where possible. New tools will be added when they solve a real everyday need.</p></div></section>
</main></BaseLayout>