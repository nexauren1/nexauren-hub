---
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryCard from "../components/CategoryCard.astro";
import ToolCard from "../components/ToolCard.astro";
import {categories,tools,getToolsByCategory} from "../lib/catalog";
const featuredIds=["image-resizer","image-compressor","merge-pdf","extract-pdf-pages","word-counter","json-formatter","url-encoder","uuid-generator"];
const featured=featuredIds.map(id=>tools.find(t=>t.id===id)).filter(Boolean);
---
<BaseLayout title="Free Online Tools for Images, PDF, Text & Audio | Nexauren Hub" description="Use free online tools to resize and compress images, work with PDFs, clean and compare text, and trim or convert audio. Simple tools with clear controls and browser-side processing where supported.">
<main id="main-content" class="home-redesign">
<section class="home-hero"><div class="container home-hero-layout">
<div class="home-hero-copy"><span class="home-eyebrow"><i></i> THE ONLINE TOOLBOX</span><h1>Small task?<br/><span>Sorted.</span></h1>
<p class="home-lede">Get useful work done with free online tools for images, PDFs, text and audio. No clutter. No software to install. Just the tool you came for.</p>
<form class="home-search" action="/tools/" method="get" role="search"><span class="home-search-icon" aria-hidden="true">⌕</span><label class="sr-only" for="home-tool-search">Search tools</label><input id="home-tool-search" type="search" name="q" placeholder="What do you want to do?" list="home-tool-suggestions" autocomplete="off"/><datalist id="home-tool-suggestions">{tools.map(tool=><option value={tool.name}/>)}</datalist><button type="submit">Find a tool <span>→</span></button></form>
<div class="home-search-examples"><span>Popular:</span><a href="/tools/image/image-resizer/">Resize image</a><a href="/tools/pdf/merge-pdf/">Merge PDF</a><a href="/tools/text/word-counter/">Word counter</a></div>
<div class="home-trust-row"><span><b>✓</b> Free to use</span><span><b>✓</b> No account needed</span><span><b>✓</b> Local processing where supported</span></div></div>
<aside class="home-hero-side"><div class="hero-side-top"><div><span class="home-mini-label">START HERE</span><h2>What do you need done?</h2></div><span class="hero-side-burst">✳</span></div>
<div class="hero-task-list"><a class="hero-task hero-task-image" href="/tools/image/"><span class="hero-task-icon">▧</span><span><strong>Image tools</strong><small>Resize, compress, crop, convert</small></span><span class="hero-task-arrow">↗</span></a>
<a class="hero-task hero-task-pdf" href="/tools/pdf/"><span class="hero-task-icon">▤</span><span><strong>PDF tools</strong><small>Merge, extract, rotate, inspect</small></span><span class="hero-task-arrow">↗</span></a>
<a class="hero-task hero-task-text" href="/tools/text/"><span class="hero-task-icon">¶</span><span><strong>Text tools</strong><small>Count, compare, format, clean</small></span><span class="hero-task-arrow">↗</span></a>
<a class="hero-task hero-task-audio" href="/tools/audio/"><span class="hero-task-icon">♫</span><span><strong>Audio tools</strong><small>Trim, join, inspect, convert</small></span><span class="hero-task-arrow">↗</span></a></div>
<a class="hero-side-all" href="/tools/">Browse all {tools.length} tools <span>→</span></a></aside>
</div></section>
<section class="home-proof-strip"><div class="container home-proof-grid"><div><strong>{tools.length}</strong><span>practical tools</span></div><div><strong>{categories.length}</strong><span>clear categories</span></div><div><strong>Free</strong><span>to get started</span></div><div><strong>Private</strong><span>where supported</span></div></div></section>
<section class="home-section home-category-section"><div class="container"><div class="home-section-heading"><div><span class="home-section-kicker">BROWSE BY TASK</span><h2>Pick a category.<br/><span>Get straight to work.</span></h2><p>Organized around the job you need to finish, not a complicated product menu.</p></div><a class="home-outline-link" href="/tools/">All tools <span>↗</span></a></div><div class="category-grid home-category-grid">{categories.map(category=><CategoryCard category={category} count={getToolsByCategory(category.slug).length}/>)}</div></div></section>
<section class="home-section home-featured-section"><div class="container"><div class="home-section-heading"><div><span class="home-section-kicker">QUICK WINS</span><h2>Useful tools, ready when you are.</h2><p>Each tool is built around one task, with controls that help you understand the result.</p></div><a class="home-outline-link" href="/tools/">Explore the library <span>↗</span></a></div><div class="tools-grid home-featured-grid">{featured.map(tool=><ToolCard tool={tool}/>)}</div></div></section>
<section class="home-section"><div class="container home-how-layout"><div class="home-how-copy"><span class="home-section-kicker">NO LEARNING CURVE</span><h2>From task to result<br/><span>in three steps.</span></h2><p>Skip heavyweight editors for everyday jobs. Choose a focused tool and follow the simple controls.</p><a href="/faq/" class="home-text-link">How the tools work <span>→</span></a></div><div class="home-how-steps"><article><span>01</span><div><h3>Choose your tool</h3><p>Search by task or browse Image, PDF, Text and Audio.</p></div></article><article><span>02</span><div><h3>Add your file or text</h3><p>Choose a file and adjust only the settings that matter.</p></div></article><article><span>03</span><div><h3>Download or copy</h3><p>Review the result and take it with you when the tool supports export.</p></div></article></div></div></section>
<section class="home-privacy-section"><div class="container"><div class="home-privacy-card"><span class="home-privacy-icon">⌁</span><div><span class="home-section-kicker">PRIVACY MATTERS</span><h2>Your files are yours.</h2><p>Tools that support local processing work directly in your browser, so your files do not need to be sent to a Nexauren processing server. Browser support and file-size limits vary by tool.</p><a href="/privacy/">Read the privacy approach <span>→</span></a></div><span class="home-privacy-yellow">✳</span></div></div></section>
<section class="home-seo-section"><div class="container"><span class="home-section-kicker">NEXAUREN HUB</span><h2>Everyday online utilities, in one place.</h2><p>Nexauren Hub brings together free online image tools, PDF utilities, text helpers and audio tools. Resize a photo before uploading it, compress an image for a website, combine documents, extract selected PDF pages, count words for an assignment, compare two versions of text, or trim a supported audio clip. Each page explains what its tool does, how to use it and which formats or browser limitations to expect.</p><p>Start with a category or search for the task you have in mind. The tool library is designed to stay focused on practical results: clear controls, meaningful feedback, and an output you can download or copy when supported.</p></div></section>
</main></BaseLayout>