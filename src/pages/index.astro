---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import CategoryCard from "../components/CategoryCard.astro";
import ToolCard from "../components/ToolCard.astro";
import {categories,tools,getToolsByCategory} from "../lib/catalog";
const popular=["image-resizer","merge-pdf","word-counter","audio-trimmer"].map(id=>tools.find(t=>t.id===id)!).filter(Boolean);
---
<BaseLayout title="Nexauren Hub — Free Online Image, PDF, Text & Audio Tools" description="Free online tools for images, PDF documents, text and audio. Resize images, merge PDFs, count words and trim audio in your browser. No account required.">
<main id="main-content">
<section class="hero-section"><div class="hero-orb hero-orb-one"></div><div class="container hero-grid"><div class="hero-copy">
<div class="hero-kicker"><i class="status-pulse"></i> YOUR EVERYDAY TOOLKIT <span class="kicker-divider"></span> FREE TO USE</div><h1>Small tasks.<br/><span class="gradient-text">Smoother workflows.</span></h1><p class="hero-description">A growing collection of practical online tools for images, PDFs, text and audio. No clutter, no account required — just get the job done.</p>
<form class="hero-search" action="/tools/" method="get" role="search"><span class="search-symbol">⌕</span><label class="sr-only" for="hero-search">Search online tools</label><input id="hero-search" name="q" type="search" placeholder="What do you need to do today?"/><button class="button button-primary" type="submit">Find a tool ↗</button></form>
<div class="hero-proof"><span>✓ Free tools</span><span>✓ Browser-based processing</span><span>✓ No sign-up needed</span></div></div>
<div class="hero-visual" aria-label="Preview of the Nexauren Hub tool library"><div class="visual-window"><div class="window-bar"><i></i><i></i><i></i><span>nexauren / workspace</span><b>⌑</b></div><div class="visual-body"><div class="visual-heading"><div><span class="eyebrow">YOUR TOOLKIT</span><h2>What are we making?</h2></div><span class="visual-avatar">N</span></div><div class="visual-tool-grid"><div class="visual-tool visual-blue"><span>▧</span><b>Image tools</b><small>Resize · Compress</small></div><div class="visual-tool visual-purple"><span>▤</span><b>PDF tools</b><small>Merge · Extract</small></div><div class="visual-tool visual-cyan"><span>¶</span><b>Text tools</b><small>Count · Clean</small></div><div class="visual-tool visual-pink"><span>♫</span><b>Audio tools</b><small>Trim · Convert</small></div></div><div class="visual-bottom"><span>✦</span><div><b>Built for real work</b><small>Helpful, focused and easy to use.</small></div><strong>↗</strong></div></div></div><div class="floating-pill pill-one">✦ No account needed</div><div class="floating-pill pill-two">◉ Designed for privacy</div></div></div><div class="hero-grid-pattern"></div></section>
<section class="trust-strip"><div class="container trust-inner"><span>MADE FOR EVERYDAY TASKS</span><div><b>01</b> Straightforward tools</div><div><b>02</b> Clear results</div><div><b>03</b> Your files stay yours</div></div></section>
<section class="section-block"><div class="container"><SectionHeading eyebrow="FIND YOUR WORKFLOW" title="One hub. Four useful categories." description="Choose a category to find a focused tool for the job." href="/tools/" linkLabel="Browse all tools"/><div class="category-grid">{categories.map(c=><CategoryCard category={c} count={getToolsByCategory(c.slug).length}/>)}</div></div></section>
<section class="section-block section-shaded"><div class="container"><SectionHeading eyebrow="GET STARTED" title="Tools worth keeping close" description="Start with everyday tasks. More tools will be added as they're ready." href="/tools/" linkLabel="Explore the library"/><div class="tools-grid">{popular.map(tool=><ToolCard tool={tool}/>)}</div></div></section>
<section class="section-block"><div class="container"><div class="privacy-banner"><div class="privacy-banner-icon">⌁</div><div><span class="eyebrow">DESIGNED WITH CARE</span><h2>Useful by design. Private by default.</h2><p>Where practical, tools process files locally in your browser instead of uploading them to a processing server. You stay in control of your files.</p><a class="text-link" href="/privacy/">Read our privacy approach ↗</a></div><div class="privacy-orbit"><span>✳</span><i></i><b></b></div></div></div></section>
<section class="section-block section-shaded"><div class="container cta-section"><span class="eyebrow">MAKE YOUR NEXT TASK EASIER</span><h2>Find the right tool.<br/><span class="gradient-text">Get on with your day.</span></h2><p>Simple utilities for the little jobs that add up.</p><a class="button button-primary" href="/tools/">Browse all tools →</a></div></section>
</main></BaseLayout>