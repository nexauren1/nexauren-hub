---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import ToolWorkspace from "../../../../components/ToolWorkspace.astro";
import ToolCard from "../../../../components/ToolCard.astro";
import {categories,tools} from "../../../../lib/catalog";
export function getStaticPaths(){return tools.map(tool=>({params:{category:tool.category,slug:tool.slug},props:{tool}}));}
const {tool}=Astro.props;const category=categories.find(c=>c.slug===tool.category)!;const related=tools.filter(t=>t.category===tool.category&&t.id!==tool.id).slice(0,3);
const faqSchema={"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":`Is ${tool.name} free?`,"acceptedAnswer":{"@type":"Answer","text":"Yes. This tool is currently free to use and does not require an account."}},{"@type":"Question","name":"Are my files uploaded?","acceptedAnswer":{"@type":"Answer","text":"The processing described on this page is designed to run in your browser. Supported formats and practical size limits depend on your device and browser."}},{"@type":"Question","name":"Why did my file fail?","acceptedAnswer":{"@type":"Answer","text":"The browser may not support the source format, the file may be damaged, or the device may not have enough memory. Try a supported format or a smaller file."}}]};
---
<BaseLayout title={tool.seoTitle} description={tool.seoDescription}>
<main id="main-content" class="page-main tool-page"><div class="container"><nav class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/tools/">Tools</a><span>/</span><a href={`/tools/${category.slug}/`}>{category.name}</a><span>/</span><span>{tool.name}</span></nav>
<div class="tool-page-grid"><article class="tool-intro"><span class="eyebrow">{category.label} TOOL</span><div class="tool-title-row"><span class="tool-icon tool-icon-large">{tool.icon}</span><div><h1>{tool.name}</h1><p>{tool.tagline}</p></div></div><p class="tool-description">{tool.description}</p><div class="tool-badges"><span>✓ Free to use</span><span>✓ No account required</span><span>✓ Browser-based</span></div></article><ToolWorkspace tool={tool}/></div>
<section class="tool-details content-prose"><div><span class="eyebrow">HOW IT WORKS</span><h2>How to use {tool.name.toLowerCase()}</h2><ol class="steps-list">{tool.steps.map((step,i)=><li><span>{i+1}</span><p>{step}</p></li>)}</ol></div><aside class="detail-side"><h3>What you can do</h3><ul>{tool.features.map(f=><li>✓ {f}</li>)}</ul><div class="detail-note"><strong>Good to know</strong><p>Processing depends on your browser, device memory and source file. Keep a copy of important originals before making changes.</p></div></aside></section>
{related.length>0&&<section class="related-section"><div class="section-heading"><div><span class="eyebrow">KEEP GOING</span><h2>More {category.name.toLowerCase()}</h2></div><a class="text-link" href={`/tools/${category.slug}/`}>View category ↗</a></div><div class="tools-grid">{related.map(item=><ToolCard tool={item}/>)}</div></section>}
<section class="tool-faq content-prose"><h2>Frequently asked questions</h2><details><summary>Is {tool.name.toLowerCase()} free?</summary><p>Yes. This tool is currently free to use and does not require an account.</p></details><details><summary>Are my files uploaded?</summary><p>The tool is designed to process files in your browser. Supported formats and size limits depend on your device and browser; routine hosting requests may still be logged by infrastructure providers.</p></details><details><summary>Why did my file fail?</summary><p>The browser may not support the source format, the file may be damaged, or the device may not have enough memory. Try a supported format or a smaller file.</p></details></section>
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)}/>
</div></main></BaseLayout>