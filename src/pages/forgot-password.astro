---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Reset Password — Nexauren Hub" description="Request a password recovery link for your Nexauren Hub account." noindex={true}>
<main id="main-content" class="page-main auth-page"><div class="container auth-container"><a href="/login/" class="back-link">← Back to login</a><section class="auth-card auth-card-light"><span class="brand-mark auth-brand">N</span><span class="eyebrow">ACCOUNT RECOVERY</span><h1>Reset your <span class="gradient-text">password.</span></h1><p>Enter the email linked to your account. If it exists, a recovery link will be sent.</p><form data-auth-form="forgot" class="auth-form"><label class="field-label">Email address<input name="email" type="email" autocomplete="email" placeholder="you@example.com" required/></label><button type="submit" class="button button-primary button-full">Send recovery link →</button><p class="auth-feedback" data-auth-message role="status" aria-live="polite" hidden></p></form><p class="auth-switch"><a href="/login/">Return to login</a></p></section></div></main><script>import "../scripts/auth-forms";</script>
</BaseLayout>