---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Completing Sign In — Nexauren Hub" description="Completing your Nexauren Hub sign-in securely." noindex={true}>
<main id="main-content" class="page-main auth-page"><div class="container auth-container"><section class="auth-card auth-card-light callback-card" data-auth-callback><span class="brand-mark auth-brand">N</span><span class="eyebrow">SECURE SIGN-IN</span><h1>Just a <span class="gradient-text">moment.</span></h1><p>Finishing your sign-in and checking your session.</p><p class="auth-feedback" data-auth-message role="status" aria-live="polite">Checking your sign-in…</p><a href="/login/" class="text-link">Return to login ↗</a></section></div></main><script>import "../../scripts/auth-forms";</script>
</BaseLayout>